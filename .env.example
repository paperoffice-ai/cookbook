# PaperOffice AI API — Environment Variables
# Copy this file to .env and replace with your real credentials.
#
#   cp .env.example .env
#
# Never commit your .env to version control!

# ── API Key ──────────────────────────────────────────────────────────
# User token (po_ut_) or group token (po_gt_) from app.paperoffice.ai → Account → API.
# Works for the REST API and for MCP. A system key (po_sk_) works for REST only;
# the MCP server rejects po_sk_ and po_pk_.
PAPEROFFICE_API_KEY=po_ut_your_user_token_here

# ── Base URL ─────────────────────────────────────────────────────────
# Production (default — do NOT change unless you know what you're doing)
PAPEROFFICE_API_BASE=https://api.paperoffice.ai/latest

# ── MCP Endpoints ────────────────────────────────────────────────────
# Use the URL matching your AI client:
#   Cursor / Windsurf → https://mcp.paperoffice.ai/cursor
#   Claude Desktop    → https://mcp.paperoffice.ai/claude   (OAuth, no token needed)
#   ChatGPT           → https://mcp.paperoffice.ai/chatgpt  (OAuth, no token needed)
#   Grok              → https://mcp.paperoffice.ai/grok     (OAuth, no token needed)
#   Headless DMS      → https://mcp.paperoffice.ai/dms
#   Everything        → https://mcp.paperoffice.ai/mcp-full
PAPEROFFICE_MCP_URL=https://mcp.paperoffice.ai/cursor

# ── Defaults ─────────────────────────────────────────────────────────
# Start-SLA lane: no_sla | sla_24h | sla_12h | sla_6h | sla_1h | instant
PAPEROFFICE_DEFAULT_PROCESSING_LANE=instant

# OCR mode: text | grid | complete
PAPEROFFICE_OCR_MODE=text

# TTS voice (see /voices_info for full list)
PAPEROFFICE_TTS_VOICE=Nadja

# TTS language
PAPEROFFICE_TTS_LANGUAGE=de
