# PaperOffice AI API — Environment Variables
# Copy this file to .env and replace with your real credentials.
#
#   cp .env.example .env
#
# Never commit your .env to version control!

# ── API Key ──────────────────────────────────────────────────────────
# System Key (server-to-server, full access)
PAPEROFFICE_API_KEY=po_sk_your_system_key_here

# User Token (optional — user-scoped, license-dependent)
# PAPEROFFICE_USER_TOKEN=po_ut_your_user_token_here

# ── Base URL ─────────────────────────────────────────────────────────
# Production (default — do NOT change unless you know what you're doing)
PAPEROFFICE_API_BASE=https://api.paperoffice.ai/latest

# ── MCP Endpoints ────────────────────────────────────────────────────
# Use the URL matching your AI client:
#   Cursor IDE       → https://mcp.paperoffice.ai/cursor
#   Claude Desktop   → https://mcp.paperoffice.ai/claude
#   ChatGPT / OpenAI → https://mcp.paperoffice.ai/openai
#   Standard MCP     → https://mcp.paperoffice.ai/mcp
#   Universal        → https://mcp.paperoffice.ai/
PAPEROFFICE_MCP_URL=https://mcp.paperoffice.ai/cursor

# ── Defaults ─────────────────────────────────────────────────────────
# Priority: 900+ = sync (dev/testing), 500 = async (production default)
PAPEROFFICE_DEFAULT_PRIORITY=900

# OCR mode: text | grid | complete
PAPEROFFICE_OCR_MODE=text

# TTS voice (see /voices_info for full list)
PAPEROFFICE_TTS_VOICE=Nadja

# TTS language
PAPEROFFICE_TTS_LANGUAGE=de
